# Flutter/Dart/Pub related
# Libraries should not include pubspec.lock, per https://dart.dev/guides/libraries/private-files#pubspeclock.
/pubspec.lock
**/doc/api/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
build/

# Trust Wallet Core 预编译产物（与 ab_pay 一致：不入库，由本地或 CI 放入后再构建）
# Android: android/libs/trustwalletcore-release.aar（见 android/build.gradle）
# iOS: ios/Frameworks/*.xcframework（见 podspec vendored_frameworks）
#     至少需要同一套构建产出的：WalletCore.xcframework + SwiftProtobuf.xcframework（WalletCore 动态链接 SwiftProtobuf）
android/libs/*.aar
ios/Frameworks/*